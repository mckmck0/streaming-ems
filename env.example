# Copy to .env (gitignored). Only the ems-gen container (`make gen`) reads .env; commands run on the host
# (`uv run`, `make`) do not, so export the variables in your shell. No value here is a secret.
# Settings are read by src/ems/settings.py (prefix EMS_); YAML in config/ holds behaviour.
EMS_KAFKA_BOOTSTRAP=localhost:9092
EMS_TOPICS_PROFILE=live
# EMS_TOPIC_PREFIX=
# Spec 002 (live data): Open-Meteo customer API key (leave unset for the free non-commercial API).
# EMS_OPEN_METEO_API_KEY=
# Spec 002: ENTSO-E Transparency Platform token. Register at transparency.entsoe.eu, then e-mail
# transparency@entsoe.eu with subject "RESTful API access".
# EMS_ENTSOE_TOKEN=
